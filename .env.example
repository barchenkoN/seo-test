# Ключ 2captcha (обязательно). Можно не заполнять и вставить ключ прямо в интерфейсе.
TWOCAPTCHA_API_KEY=your_2captcha_key_here

# Необязательные настройки (значения по умолчанию)
# TARGET_URL=https://linkreclamatiogrwc.uk/
# CONCURRENCY=5          # сколько строк отправляется одновременно (больше = быстрее, но выше риск лимита на сайте)
# MAX_ATTEMPTS=3         # попыток на строку при временных ошибках (капча, сеть, токен формы, лимит сайта)
# MAX_TARGETS=1000       # максимум строк в одной отправке
# CAPTCHA_TIMEOUT=180    # сек. ожидания решения капчи
# THROTTLE_PAUSE=30      # пауза всех отправок, если сайт начал ограничивать (сек. × номер попытки)
# APP_PASSWORD=          # если задать — интерфейс спросит пароль (логин любой)
# PORT=8000
